{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated pipeline answers",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "question",
      "answer",
      "contexts",
      "ground_truth",
      "distribution",
      "generation_mode",
      "generation_model"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1
      },
      "question": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "answer": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "contexts": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "ground_truth": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "distribution": {
        "enum": [
          "factual",
          "multi_hop",
          "adversarial"
        ]
      },
      "generation_mode": {
        "enum": [
          "llm",
          "extractive_fallback"
        ]
      },
      "generation_model": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "generation_mode": {
              "const": "llm"
            }
          }
        },
        "then": {
          "properties": {
            "generation_model": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "else": {
          "properties": {
            "generation_model": {
              "type": "null"
            }
          }
        }
      }
    ]
  },
  "minItems": 50,
  "maxItems": 50
}
